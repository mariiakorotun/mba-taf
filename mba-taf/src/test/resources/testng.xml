<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MBA Regression" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="com.mba.taf.core.listeners.TestListener"/>
        <listener class-name="com.mba.taf.core.listeners.RetryTransformer"/>
    </listeners>
    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="known-defect"/>
            </run>
        </groups>
        <packages>
            <package name="com.mba.taf.tests.*"/>
        </packages>
    </test>
</suite>
